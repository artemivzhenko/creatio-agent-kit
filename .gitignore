# --- the kit ---
# the working kitchen: cards, queues, feedback, surveys, the agents' scratch - never content
dev/
# Claude Code settings are personal: the hooks of the kitchen are registered in settings.local.json
.claude/
# the private name list lives above the kit, never inside it
.private/

# --- Python (the MCP servers, the toolkits, the hooks) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
# the creatio-kb server's per-call size log (mcp-server/tool_stats.py)
creatio-knowledge-base/mcp-server/.stats/

# --- written by the tools next to the packages they work on, never content ---
# the package index (describe.py index / find_schema) and the base-object cache (objects.py)
.creatio-index/
.creatio-bases/
# development helpers (hooks, scripts): local only, never content
.helpers/
!creatio-knowledge-base/no-code/tools/objects/tests/fixtures/.creatio-bases/
.dev/
# --- creatio-knowledge-base ---
creatio-knowledge-base/**/example.*
creatio-knowledge-base/**/test.*
creatio-knowledge-base/articles/*

# --- automatic-creatio-tests: .NET build output and IDE files ---
automatic-creatio-tests/**/bin/
automatic-creatio-tests/ai_helpers/
automatic-creatio-tests/**/obj/
automatic-creatio-tests/**/[Bb]uild/
automatic-creatio-tests/**/artifacts/
automatic-creatio-tests/**/.vs/
automatic-creatio-tests/**/.idea/
automatic-creatio-tests/**/*.user
automatic-creatio-tests/**/*.suo
automatic-creatio-tests/**/*.userprefs
automatic-creatio-tests/**/*.userosscache
automatic-creatio-tests/**/*.sln.docstates
automatic-creatio-tests/**/*.log
automatic-creatio-tests/**/*.tlog
automatic-creatio-tests/**/*.tmp
automatic-creatio-tests/**/*.bak
automatic-creatio-tests/**/*.old
automatic-creatio-tests/**/*.swp
automatic-creatio-tests/**/[Ll]og/
automatic-creatio-tests/**/[Ll]ogs/
# run reports, test results, the browser, local folders
automatic-creatio-tests/**/Reports/
automatic-creatio-tests/**/TestResults/
automatic-creatio-tests/**/.playwright/
automatic-creatio-tests/**/playwright-report/
automatic-creatio-tests/source/*
automatic-creatio-tests/ai_helpers/*
automatic-creatio-tests/backlog/*
