automatic-creatio-tests/internal_docs/*
# the site connection (holds a password)
automatic-creatio-tests/Configuration/creatio.env.config.json
# cases and page/process files written against a private site stay local; the bundled ones are listed
automatic-creatio-tests/**/*.act
automatic-creatio-tests/Configuration/pages/*.json
